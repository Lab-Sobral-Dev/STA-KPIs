# API financeira do HANA (obrigatorias)
HANA_API_URL=
HANA_API_KEY=
HANA_SCHEMA=

# Acoplamento ao Gestao SBR (src/server/auth.js).
# DOCKING_SECRET: gerado no servidor (openssl rand -hex 32) e igual ao DOCKING_SECRET_STA_KPIS do Gestao.
# Obrigatorio quando HOST nao e loopback (no container, HOST=0.0.0.0).
DOCKING_SECRET=
# true em producao (servido em https://sta-kpis.laboratoriosobral.com.br).
SESSION_COOKIE_SECURE=true
